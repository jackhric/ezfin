# Copy to apps/api/.env (or export in your shell). All values are optional.

# "mock" (default) uses synthetic demo data. "simplefin" pulls your real accounts.
EZFIN_PROVIDER=mock

# Where the SQLite database and provider credential live. Defaults to apps/api/data.
# EZFIN_DATA_DIR=/absolute/path/outside/the/repo

# Keep these on loopback. Changing the host exposes your financial data to the network.
EZFIN_HOST=127.0.0.1
EZFIN_PORT=8787

# Optional: provide the SimpleFIN access URL directly instead of claiming a setup token in the UI.
# SIMPLEFIN_ACCESS_URL=https://user:pass@beta-bridge.simplefin.org/simplefin

# Local AI categorization. Defaults target Ollama on this machine.
# EZFIN_AI_PROVIDER=ollama          # or "openai" for LM Studio, llama.cpp server, vLLM
# EZFIN_AI_URL=http://127.0.0.1:11434
# EZFIN_AI_MODEL=qwen3:4b
# EZFIN_AI_MIN_CONFIDENCE=0.6       # ignore model answers below this
# EZFIN_AI_BATCH=12                 # merchants per model request
# EZFIN_AI_ALLOW_REMOTE=0           # leave at 0. 1 lets the API talk to a non-loopback AI endpoint.
