{
  "name": "ezfin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run web#dev",
    "dev:api": "vp run api#dev",
    "seed": "vp run api#seed",
    "start": "vp run web#build && vp run api#start",
    "ready": "vp check && vp run -r test && vp run -r build"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
